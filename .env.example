# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=
# Optional: same value for older next-auth env names
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# MongoDB (Atlas connection string or local)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/koze?retryWrites=true&w=majority

# Existing Koze keys
GOOGLE_API_KEY=
API_KEY=
VOICERS_API_KEY=
NINJA_API_KEY=

# Optional OAuth (Google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

    "unitId": "foundations",
    "level": "beginner",
    "estimatedMinutes": 13,
    "steps": [
      {
        "type": "intro",
        "title": "Small words, big difference",
        "body": "Chinese interactions expect 请 and 谢谢."
      },
      {
        "type": "tip",
        "title": "Please & thanks",
        "body": "请 is “please.” 谢谢 is “thank you.”",
        "bullets": [
          "非常感谢 = thank you very much.",
          "不客气 = you’re welcome.",
          "对不起 / 抱歉 = sorry.",
          "请 is also used before verbs to soften requests."
        ]
      },
      {
